#!/usr/bin/env bash

# Change directory to the folder of the specified file
function sd() {
	local dirname="${@%/}";
	[ -f "${dirname}" ] && dirname=`dirname "${dirname}"`;
	cd "${dirname}";
}

# Cleans an OS X zipped file by removing __MACOSX and .DS_Store files
function rezip() {
	if [ -z "${1}" ]; then
		echo "Usage: \`rezip file.zip\`"
		return 1
	fi;
	local filename="${@%/}"
	if [ "${filename##*.}" = "zip" ]; then
		[ -f "${filename}" ] && echo Fixing ${filename} && zip -d ${filename} \*.DS_Store || true && zip -d ${filename} __MACOSX/
	else
		echo "Invalid file format"
	fi
}

# Concatenate every file under the given folders into one annotated output file
# (handy for feeding a whole codebase to an LLM). The first argument is a file
# extension to include, or "*" for every file. Non-UTF-8 files are skipped.
# Usage: _combine_files <ext|*> <output_file> <input_folder> [input_folder ...]
function _combine_files() {
	local ext="${1}"; shift
	local output_file
	output_file=$(realpath -m "${1}"); shift
	mkdir -p "$(dirname "${output_file}")"

	{
		[ "${ext}" = "php" ] && echo "<?php"
		echo "/* Combined ${ext} files from multiple directories */"
		echo "/* Input directories: $* */"
		echo "/* Generated on $(date) */"
		echo ""
	} > "${output_file}"

	local total_files=0 invalid_dirs=0 input_folder file file_count
	for input_folder in "$@"; do
		input_folder=$(realpath -m "${input_folder}")
		if [ ! -d "${input_folder}" ]; then
			echo "Warning: '${input_folder}' is not a valid directory. Skipping."
			invalid_dirs=$((invalid_dirs + 1))
			continue
		fi

		printf '/* Processing directory: %s */\n\n' "${input_folder}" >> "${output_file}"
		file_count=0
		while IFS= read -r file; do
			[ -z "${file}" ] && continue
			# Never swallow the output file itself
			[ "$(realpath -m "${file}")" = "${output_file}" ] && continue
			if ! iconv -f UTF-8 -t UTF-8 < "${file}" > /dev/null 2>&1; then
				echo "Skipping file with invalid UTF-8: ${file}"
				continue
			fi
			printf '/* File: %s */\n\n' "${file}" >> "${output_file}"
			cat "${file}" >> "${output_file}"
			printf '\n/* End of file: %s */\n\n' "${file}" >> "${output_file}"
			file_count=$((file_count + 1))
		done < <(if [ "${ext}" = "*" ]; then find "${input_folder}" -type f; else find "${input_folder}" -type f -name "*.${ext}"; fi | sort)

		printf '/* Processed %s files from %s */\n\n' "${file_count}" "${input_folder}" >> "${output_file}"
		total_files=$((total_files + file_count))
		echo "Processed ${file_count} files from '${input_folder}'"
	done

	[ "${ext}" = "php" ] && echo "?>" >> "${output_file}"

	echo "----------------------------------------"
	echo "Summary:"
	echo "- Total input directories: $#"
	echo "- Valid directories processed: $(($# - invalid_dirs))"
	echo "- Total files combined: ${total_files}"
	echo "- Output file: ${output_file}"

	if [ "${total_files}" -eq 0 ]; then
		echo "Warning: No files were found in the specified directories."
		return 1
	fi
}

# Combine every file under the given folders into one file
# Usage: combine_all_files <output_file> <input_folder> [input_folder ...]
function combine_all_files() {
	if [ "$#" -lt 2 ]; then
		echo "Usage: combine_all_files <output_file> <input_folder1> [input_folder2 ...]"
		return 1
	fi
	_combine_files "*" "$@"
}

# Combine every PHP file under the given folders into one file
# Usage: combine_php_files <output_file> <input_folder> [input_folder ...]
function combine_php_files() {
	if [ "$#" -lt 2 ]; then
		echo "Usage: combine_php_files <output_file> <input_folder1> [input_folder2 ...]"
		return 1
	fi
	_combine_files "php" "$@"
}

# A Zellij session name for a repository: its own directory name, prefixed with the nearest
# meaningful parent so that ten different "web" checkouts do not all answer to one session.
# ~/Work/Client/acme/Projects/web -> acme-web, ~/Projects/dotfiles -> dotfiles.
function _cockpit_session_name() {
	local repo="${1%/}" base parent name
	base="${repo##*/}"
	parent="${repo%/*}"
	# Walk past the container directories that say nothing about which project this is
	while [ -n "${parent}" ] && [ "${parent}" != "/" ] && [ "${parent}" != "${HOME}" ]; do
		case "${parent##*/}" in
			Projects|projects|Work|work|Client|Clients|clients|src|repos|code|dev|Desktop|Documents|Sites)
				parent="${parent%/*}"
				continue
				;;
		esac
		break
	done
	name="${parent##*/}"
	if [ -z "${name}" ] || [ "${parent}" = "${HOME}" ] || [ "${parent}" = "/" ]; then
		name="${base}"
	elif [ "$(printf '%s' "${name}" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "${base}" | tr '[:upper:]' '[:lower:]')" ]; then
		name="${base}"
	else
		name="${name}-${base}"
	fi
	# Zellij session names travel through shell words and a terminal title, so keep them plain
	printf '%s' "${name}" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//'
}

# Open the Claude Code + lazygit + shell layout (see .config/zellij/layouts/cockpit.kdl),
# as a new tab when already inside Zellij, or switch to the tab when it is already open.
# Claude runs in the current directory; lazygit and the shell run in the git repository: this
# directory, the one given with -p, or one picked from Projects/ when started from a client
# folder. Both choices are remembered per directory, so a plain `cockpit` comes back to the
# same repository and the same Claude conversation without asking.
#   cockpit               resume the conversation last open here (a new one the first time)
#   cockpit -n            start a new Claude conversation, remembered from then on
#   cockpit -c            continue the most recent Claude conversation of this directory
#   cockpit -r [id]       pick a past conversation of this directory, or resume the given one
#   cockpit -p <repo>     repository for lazygit and the shell, remembered from then on
#   cockpit --pick        pick the repository from Projects/ again
# The conversation is tracked by claude/hooks/cockpit-session.sh, so /clear and /resume inside
# the cockpit move the remembered conversation along with them.
function cockpit() {
	if [ ! -t 0 ]; then
		echo "cockpit needs an interactive terminal (run it in Ghostty, not through a tool)"
		return 1
	fi
	local mode="resume" args="" project="" pick=0
	while [ $# -gt 0 ]; do
		case "$1" in
			-n|--new) mode="new" ;;
			-c|--continue) mode="explicit"; args=' "--continue"' ;;
			-r|--resume)
				mode="explicit"
				args=' "--resume"'
				if [ -n "${2:-}" ] && [ "${2#-}" = "${2}" ]; then
					args=" \"--resume\" \"${2}\""
					shift
				fi
				;;
			-p|--project)
				if [ -z "${2:-}" ]; then
					echo "cockpit: -p needs a repository path"
					return 1
				fi
				project="${2}"
				shift
				;;
			--pick) pick=1 ;;
			*) echo "Usage: cockpit [-n|--new] [-c|--continue] [-r|--resume [session-id]] [-p|--project <repo>] [--pick]"; return 1 ;;
		esac
		shift
	done

	local state="${XDG_STATE_HOME:-$HOME/.local/state}/cockpit"
	local repo_file="${state}/$(printf '%s' "${PWD}" | shasum | cut -c1-16).repo"
	mkdir -p "${state}"

	if [ -z "${project}" ]; then
		if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
			project="."
		elif [ "${pick}" -eq 0 ] && [ -d "$(cat "${repo_file}" 2> /dev/null)" ]; then
			project="$(cat "${repo_file}")"
		else
			[ -n "${ZSH_VERSION}" ] && setopt local_options null_glob
			local candidates=() dir choice i
			for dir in Projects/*/ */; do
				[ -d "${dir}.git" ] && candidates+=("${dir%/}")
			done
			case "${#candidates[@]}" in
				0) echo "cockpit: no git repository here or under Projects/; use -p <repo>"; return 1 ;;
				1) project="${candidates[@]}" ;;
				*)
					echo "Repository for lazygit and the shell:"
					i=1
					for dir in "${candidates[@]}"; do
						echo "  ${i}) ${dir}"
						i=$((i + 1))
					done
					printf "> "
					read -r choice
					if ! [ "${choice}" -ge 1 ] 2> /dev/null || [ "${choice}" -gt "${#candidates[@]}" ]; then
						echo "cockpit: no repository chosen"
						return 1
					fi
					project="${candidates[@]:$((choice - 1)):1}"
					;;
			esac
		fi
	fi
	project="$(cd "${project}" 2> /dev/null && pwd)" || { echo "cockpit: no such directory: ${project}"; return 1; }
	printf '%s\n' "${project}" > "${repo_file}"

	# The session is named after the repository, so the terminal tab reads "repo | title".
	# An open tab or running session of that name is reused rather than duplicated.
	local session zstate
	session="$(_cockpit_session_name "${project}")"
	if [ -n "${ZELLIJ}" ] && zellij action query-tab-names 2> /dev/null | grep -qxF "${session}"; then
		zellij action go-to-tab-name "${session}"
		return
	fi
	if [ -z "${ZELLIJ}" ]; then
		zstate="$(zellij list-sessions --no-formatting 2> /dev/null \
			| awk -v s="${session}" '$1 == s { print (index($0, "EXITED") ? "exited" : "running"); exit }')"
		if [ "${zstate}" = "running" ]; then
			echo "cockpit: attaching to the running '${session}' session"
			zellij attach "${session}"
			return
		fi
	fi

	# One remembered conversation per directory and repository. Resume it while Claude still
	# has it; otherwise (first run, -n, or a conversation Claude has since deleted) start a new
	# one under an ID chosen here, so it is remembered from its first message.
	local session_file sid
	session_file="${state}/$(printf '%s\t%s' "${PWD}" "${project}" | shasum | cut -c1-16).session"
	if [ "${mode}" = "resume" ]; then
		sid="$(cat "${session_file}" 2> /dev/null)"
		if [ -n "${sid}" ] && [ -n "$(find "$HOME/.claude/projects" -maxdepth 2 -name "${sid}.jsonl" -print -quit 2> /dev/null)" ]; then
			args=" \"--resume\" \"${sid}\""
		else
			mode="new"
		fi
	fi
	if [ "${mode}" = "new" ]; then
		sid="$(uuidgen | tr '[:upper:]' '[:lower:]')"
		printf '%s\n' "${sid}" > "${session_file}"
		args=" \"--session-id\" \"${sid}\""
	fi

	# Zellij layouts take no arguments, so build one from the template with the Claude flags
	# and the working directories filled in. Claude starts through `env` so that it, and the
	# hook that tracks its conversation, know which file to remember the conversation in.
	local template="${ZELLIJ_CONFIG_DIR:-$HOME/.config/zellij}/layouts/cockpit.kdl"
	local layout
	layout="$(mktemp -t cockpit).kdl" || return 1
	awk -v args="${args}" -v here="${PWD}" -v repo="${project}" -v file="${session_file}" '
		/COCKPIT_ARGS/ { sub(/\/\/.*/, "args \"COCKPIT_SESSION_FILE=" file "\" \"claude\"" args) }
		/command="claude"/ { sub(/command="claude"/, "command=\"env\""); sub(/ \{$/, " cwd=\"" here "\" {") }
		/name="lazygit"/ || /name="shell"/ { $0 = $0 " cwd=\"" repo "\"" }
		{ print }
	' "${template}" > "${layout}"
	if [ -n "${ZELLIJ}" ]; then
		zellij action new-tab --layout "${layout}" --name "${session}"
	else
		# A dead session still holds its name, so release it before reusing the name
		[ "${zstate}" = "exited" ] && zellij delete-session "${session}" --force > /dev/null 2>&1
		# -n starts a new session; -l would try to add the layout to an existing
		# session of that name and fail with "Session not found" when there is none
		zellij --session "${session}" --new-session-with-layout "${layout}"
	fi
	rm -f "${layout}" "${layout%.kdl}"
}

# Create a new directory and enter it
function mkd() {
	mkdir -p "$@" && cd "$_";
}

# Change working directory to the top-most Finder window location
function cdf() { # short for `cdfinder`
	cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')";
}

# Lines added and removed by the current git user across the history of this repo
function mystats() {
	git log --author="$(git config user.name)" --pretty=tformat: --numstat \
		| awk '{ add += $1; subs += $2; loc += $1 - $2 } END { printf "added lines: %s, removed lines: %s, total lines: %s\n", add, subs, loc }' -
}

# Create a .tar.gz archive, using `zopfli`, `pigz` or `gzip` for compression
function targz() {
	local tmpFile="${@%/}.tar";
	tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1;

	size=$(
		stat -f"%z" "${tmpFile}" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}" 2> /dev/null;  # GNU `stat`
	);

	local cmd="";
	if (( size < 52428800 )) && hash zopfli 2> /dev/null; then
		# the .tar file is smaller than 50 MB and Zopfli is available; use it
		cmd="zopfli";
	else
		if hash pigz 2> /dev/null; then
			cmd="pigz";
		else
			cmd="gzip";
		fi;
	fi;

	echo "Compressing .tar ($((size / 1000)) kB) using \`${cmd}\`…";
	"${cmd}" -v "${tmpFile}" || return 1;
	[ -f "${tmpFile}" ] && rm "${tmpFile}";

	zippedSize=$(
		stat -f"%z" "${tmpFile}.gz" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}.gz" 2> /dev/null; # GNU `stat`
	);

	echo "${tmpFile}.gz ($((zippedSize / 1000)) kB) created successfully.";
}

# Determine size of a file or total size of a directory
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* ./*;
	fi;
}

# Use Git’s colored diff when available
hash git &>/dev/null;
if [ $? -eq 0 ]; then
	function diff() {
		git diff --no-index --color-words "$@";
	}
fi;

# Create a data URL from a file
function dataurl() {
	local mimeType=$(file -b --mime-type "$1");
	if [[ $mimeType == text/* ]]; then
		mimeType="${mimeType};charset=utf-8";
	fi
	echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')";
}

# Start an HTTP server from a directory, optionally specifying the port
function server() {
	local port="${1:-8000}";
	sleep 1 && open "http://localhost:${port}/" &
	# Set the default Content-Type to `text/plain` instead of `application/octet-stream`
	# And serve everything as UTF-8 (although not technically correct, this doesn’t break anything for binary files)
	python3 -c $'import http.server, sys\nhandler = http.server.SimpleHTTPRequestHandler\nhandler.extensions_map = {k: v + ";charset=UTF-8" for k, v in handler.extensions_map.items()}\nhandler.extensions_map[""] = "text/plain;charset=UTF-8"\nhttp.server.test(HandlerClass=handler, port=int(sys.argv[1]))' "$port";
}

# Start a PHP server from a directory, optionally specifying the port
# (Requires PHP 5.4.0+.)
function phpserver() {
	local port="${1:-4000}";
	local ip=$(ipconfig getifaddr en0);
	sleep 1 && open "http://${ip}:${port}/" &
	php -S "${ip}:${port}";
}

# Compare original and gzipped file size
function gz() {
	local origsize=$(wc -c < "$1");
	local gzipsize=$(gzip -c "$1" | wc -c);
	local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l);
	printf "orig: %d bytes\n" "$origsize";
	printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio";
}

# Run `dig` and display the most useful info
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer;
}

# Show all the names (CNs and SANs) listed in the SSL certificate
# for a given domain
function getcertnames() {
	if [ -z "${1}" ]; then
		echo "ERROR: No domain specified.";
		return 1;
	fi;

	local domain="${1}";
	echo "Testing ${domain}…";
	echo ""; # newline

	local tmp=$(echo -e "GET / HTTP/1.0\nEOT" \
		| openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1);

	if [[ "${tmp}" = *"-----BEGIN CERTIFICATE-----"* ]]; then
		local certText=$(echo "${tmp}" \
			| openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
			no_serial, no_sigdump, no_signame, no_validity, no_version");
		echo "Common Name:";
		echo ""; # newline
		echo "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//" | sed -e "s/\/emailAddress=.*//";
		echo ""; # newline
		echo "Subject Alternative Name(s):";
		echo ""; # newline
		echo "${certText}" | grep -A 1 "Subject Alternative Name:" \
			| sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2;
		return 0;
	else
		echo "ERROR: Certificate not found.";
		return 1;
	fi;
}

# Normalize `open` across Linux, macOS, and Windows.
# This is needed to make the `o` function (see below) cross-platform.
if [ ! $(uname -s) = 'Darwin' ]; then
	if grep -q Microsoft /proc/version; then
		# Ubuntu on Windows using the Linux subsystem
		alias open='explorer.exe';
	else
		alias open='xdg-open';
	fi
fi

# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}

# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
function tre() {
	tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
}

# Zip the current project and upload it to the host described in ./config.ini
# (DESTUSERNAME, DESTHOSTNAME, DESTPATH and optionally DESTURL)
function up() {
	if [ -f config.ini ]; then
		. config.ini
		zip -r payload.zip . --exclude="*.git*" --exclude=*.DS_Store* --exclude=payload.zip --exclude=config.ini
		scp payload.zip $DESTUSERNAME@$DESTHOSTNAME:$DESTPATH
		rm payload.zip
		ssh $DESTUSERNAME@$DESTHOSTNAME "unzip -o $DESTPATH/payload.zip -d $DESTPATH"
		if ! [ -z ${DESTURL+x} ]; then open $DESTURL; fi
	else
		printf "Initialization file must first be created\r\n";
	fi;
}

# Name of the network service (Wi-Fi, Ethernet, …) behind the currently active interface
function _active_network_service() {
	local iface
	iface=$(ifconfig | pcre2grep -M -o '^[^\t:]+:([^\n]|\n\t)*status: active' | grep -Eo -m 1 '^[^\t:]+')
	networksetup -listnetworkserviceorder | grep "${iface}" | awk -F "(, )|(: )|[)]" '{print $2}'
}

# Start Tor and route the system-wide SOCKS proxy through it.
# The port is read from Homebrew's torrc so the two can never disagree (default 9050).
function starttor() {
	local service port
	service=$(_active_network_service)
	port=$(grep -iE '^[[:space:]]*SocksPort' "$(brew --prefix)/etc/tor/torrc" 2>/dev/null | awk '{print $2}' | head -n 1)
	port="${port:-9050}"

	# Ask for the administrator password upfront
	sudo -v
	# Keep-alive: update existing `sudo` time stamp until finished
	while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &

	sudo networksetup -setsocksfirewallproxy "${service}" 127.0.0.1 "${port}" off
	sudo networksetup -setsocksfirewallproxystate "${service}" on
	echo "$(tput setaf 64)" # green
	echo "SOCKS proxy 127.0.0.1:${port} enabled."
	echo "$(tput setaf 136)" # orange
	echo "Starting Tor..."
	echo "$(tput sgr0)" # color reset
	tor && stoptor
}

# Stop routing the system-wide SOCKS proxy through Tor
function stoptor() {
	local service
	service=$(_active_network_service)
	sudo networksetup -setsocksfirewallproxystate "${service}" off
	echo "$(tput setaf 64)" # green
	echo "SOCKS proxy disabled."
	echo "$(tput sgr0)" # color reset
}

# Convert a Markdown file to rich text and copy it to the clipboard (paste into Apple Notes, Mail, …)
function mdcopy() {
	if [ -z "${1}" ]; then
		echo "Usage: mdcopy file.md"
		return 1
	fi
	if [ ! -f "${1}" ]; then
		echo "File not found: ${1}"
		return 1
	fi
	if ! command -v pandoc &> /dev/null; then
		echo "pandoc is required. Install with: brew install pandoc"
		return 1
	fi
	local tmp
	tmp=$(mktemp -d) || return 1
	# Straighten typographic dashes and quotes, then Markdown -> HTML -> RTF -> clipboard
	sed -e 's/—/-/g' -e 's/[“”]/"/g' -e "s/[‘’]/'/g" "${1}" > "${tmp}/clean.md" \
		&& pandoc "${tmp}/clean.md" -f markdown -t html --ascii -o "${tmp}/body.html" \
		&& sed -i '' 's/<h2/<br><br><h2/g; s/<h3/<br><h3/g; s/<hr \/>/<br><br>/g' "${tmp}/body.html" \
		&& { echo '<html><head><meta charset="utf-8"></head><body>'; cat "${tmp}/body.html"; echo '</body></html>'; } > "${tmp}/full.html" \
		&& textutil -convert rtf -encoding UTF-8 "${tmp}/full.html" -output "${tmp}/out.rtf" \
		&& osascript -e "set the clipboard to (read (POSIX file \"${tmp}/out.rtf\") as «class RTF »)" \
		&& echo "Copied to clipboard as rich text. Cmd+V into Apple Notes." \
		|| echo "Failed to convert."
	rm -rf "${tmp}"
}
