# Ghostty configuration. Reload with Cmd+Shift+, and list every option with
# `ghostty +show-config --default --docs`. Comments must sit on their own line.

# --- Typography ---
font-family = JetBrainsMono Nerd Font Mono
font-size = 13
font-thicken = true

# --- Theme: Solarized Dark, matching vim, Terminal and the shell prompt ---
theme = Solarized Dark Patched
window-theme = auto

# --- Window ---
window-save-state = always
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
working-directory = ~/Desktop

# --- Quick terminal: the iTerm hotkey window, on the same Option+Space ---
# A global keybind needs Accessibility permission for Ghostty
# (System Settings > Privacy & Security > Accessibility).
keybind = global:alt+space=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# --- Keyboard and mouse ---
# Option sends Alt, so Alt+arrow word jumps in zsh and the Option shortcuts in
# Claude Code work. Selecting text copies it, as iTerm did.
macos-option-as-alt = true
copy-on-select = clipboard
mouse-hide-while-typing = true
clipboard-paste-protection = true

# --- Splits ---
# Ghostty's defaults already cover Cmd+D / Cmd+Shift+D (split), Cmd+Alt+arrows
# (move between splits) and Cmd+Shift+Enter (zoom). Zellij handles panes inside.
keybind = cmd+shift+e=equalize_splits
