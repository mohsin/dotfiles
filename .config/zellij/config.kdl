// Zellij configuration. Starts locked so every Ctrl+key reaches the program in the
// pane (Claude Code, nvim, lazygit). Ctrl g unlocks; then Ctrl p (pane), Ctrl t (tab),
// Ctrl n (resize), Ctrl h (move), Ctrl s (scroll), Ctrl o (session), Ctrl q (quit),
// and Ctrl g again locks. Check with `zellij setup --check`.

default_mode "locked"
theme "solarized-dark"
mouse_mode true
// A plain drag inside a pane is Zellij's own selection: it stays in the pane, joins wrapped
// lines, and lands on the clipboard on release. Shift+drag hands the mouse to Ghostty instead.
copy_on_select true
copy_command "pbcopy"
scroll_buffer_size 50000
pane_frames true
show_startup_tips false
show_release_notes false

keybinds {
    locked {
        // Only Ctrl g unlocks; the stock Ctrl n binding would steal Neovim's completion key
        unbind "Ctrl n"
    }
    normal {
        // Ctrl g, then f: the focused pane fills the tab; the same keys bring the layout back
        bind "f" {
            ToggleFocusFullscreen
            SwitchToMode "locked"
        }
        // Ctrl g, then g: lazygit as a floating pane over the current directory; q closes it
        bind "g" {
            Run "lazygit" {
                floating true
                close_on_exit true
                name "lazygit"
            }
            SwitchToMode "locked"
        }
    }
}
