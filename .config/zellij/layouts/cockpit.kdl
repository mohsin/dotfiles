// Claude Code on the left, lazygit and a shell stacked on the right. The Claude pane has no
// fixed name on purpose: its title then follows the session name Claude sets, up to the tab.
// Open with the `cockpit` shell function (a new tab when already inside Zellij).
// The Claude and lazygit panes close when their program exits; `exit` closes the shell,
// and the session ends with its last pane.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="cockpit" focus=true {
        pane split_direction="vertical" {
            pane size="60%" focus=true command="claude" close_on_exit=true {
                // COCKPIT_ARGS: the cockpit function swaps this line for `args "--continue"` or `args "--resume"`
            }
            pane split_direction="horizontal" {
                pane name="lazygit" command="lazygit" close_on_exit=true
                pane name="shell"
            }
        }
    }
}
