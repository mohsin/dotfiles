#!/usr/bin/env bash

# PATH: user scripts first, then language toolchains. Homebrew and the system
# paths are already there (login profile). Every entry is guarded so this file
# works unchanged on a machine that lacks the tool. Sourced by bash and zsh.
export PATH="$HOME/bin:$PATH";
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"; # Rust toolchain (~/.cargo/bin)
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"; # pipx
[ -d "$HOME/.composer/vendor/bin" ] && export PATH="$HOME/.composer/vendor/bin:$PATH";
[ -d "$HOME/Library/Android/sdk/platform-tools" ] && export PATH="$HOME/Library/Android/sdk/platform-tools:$PATH";
[ -d "/Applications/Blender/blender.app/Contents/MacOS" ] && export PATH="/Applications/Blender/blender.app/Contents/MacOS:$PATH";
[ -d "/opt/homebrew/opt/openjdk@11/bin" ] && export PATH="/opt/homebrew/opt/openjdk@11/bin:$PATH"; # `java` defaults to 11
[ -d "$HOME/google-cloud-sdk/bin" ] && export PATH="$HOME/google-cloud-sdk/bin:$PATH";
[ -d "$HOME/Library/Preferences/netlify/helper/bin" ] && export PATH="$HOME/Library/Preferences/netlify/helper/bin:$PATH";
[ -d "$HOME/.antigravity/antigravity/bin" ] && export PATH="$HOME/.antigravity/antigravity/bin:$PATH";
[ -d "$HOME/.antigravity-ide/antigravity-ide/bin" ] && export PATH="$HOME/.antigravity-ide/antigravity-ide/bin:$PATH";

# pnpm
export PNPM_HOME="$HOME/Library/pnpm";
[ -d "$PNPM_HOME" ] && export PATH="$PNPM_HOME:$PATH";

# bun
export BUN_INSTALL="$HOME/.bun";
[ -d "$BUN_INSTALL/bin" ] && export PATH="$BUN_INSTALL/bin:$PATH";

# pyenv: shims win over everything else so `python` is always the pyenv-selected one
export PYENV_ROOT="$HOME/.pyenv";
[ -d "$PYENV_ROOT/shims" ] && export PATH="$PYENV_ROOT/shims:$PATH";

# .NET (appended: the system install in /usr/local/share/dotnet stays first)
export DOTNET_ROOT="$HOME/.dotnet";
[ -d "$DOTNET_ROOT" ] && export PATH="$PATH:$DOTNET_ROOT:$DOTNET_ROOT/tools";

# Where nvm keeps its Node versions (nvm itself is loaded by the shell rc, lazily in zsh).
export NVM_DIR="$HOME/.nvm";

# Make Neovim the default editor, falling back to Vim on machines where it isn't installed yet.
if command -v nvim > /dev/null 2>&1; then
	export EDITOR='nvim';
else
	export EDITOR='vim';
fi;

# Enable persistent REPL history for `node`.
export NODE_REPL_HISTORY=~/.node_history;
# Allow 32³ entries; the default is 1000.
export NODE_REPL_HISTORY_SIZE='32768';
# Use sloppy mode by default, matching web browsers.
export NODE_REPL_MODE='sloppy';

# Make Python use UTF-8 encoding for output to stdin, stdout, and stderr.
export PYTHONIOENCODING='UTF-8';

# Increase Bash history size. Allow 32³ entries; the default is 500.
export HISTSIZE='32768';
export HISTFILESIZE="${HISTSIZE}";
# Omit duplicates and commands that begin with a space from history.
export HISTCONTROL='ignoreboth';

# Prefer US English and use UTF-8.
export LANG='en_US.UTF-8';
export LC_ALL='en_US.UTF-8';

# Highlight section titles in manual pages.
export LESS_TERMCAP_md=$'\e[1;33m';

# Don’t clear the screen after quitting a manual page.
export MANPAGER='less -X';

# Avoid issues with `gpg` as installed via Homebrew.
# https://stackoverflow.com/a/42265848/96656
export GPG_TTY=$(tty);

# Hide the “default interactive shell is now zsh” warning on macOS.
export BASH_SILENCE_DEPRECATION_WARNING=1;
