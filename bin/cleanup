#!/usr/bin/env bash

# Free disk space by clearing caches that every tool in the Brewfile rebuilds or re-downloads
# on its own: package manager caches, old Homebrew versions, build caches and editor indexes.
# Nothing here holds work, settings or installed versions, so the worst case after a run is a
# slower first install or build while a cache refills. Tools that are not installed are skipped.
#
# Cleared:
#   Homebrew       old versions and every download (brew cleanup --prune=all -s)
#   JavaScript     npm, nvm, pnpm (unreferenced packages only), bun, deno, node-gyp, TypeScript
#   Python         uv, pip, Poetry, conda packages, pre-commit (unused hook envs only)
#   PHP            Composer, the phpactor index (rebuilt when Neovim next opens a PHP project)
#   JVM / Android  Gradle caches (skipped while a Gradle daemon runs), CocoaPods, caches of
#                  Android Studio versions no longer installed
#   Rust / Go      downloaded crates and their unpacked sources, the Go build cache
#   Xcode          DerivedData, simulator caches, simulators for runtimes no longer installed
#   Docker         dangling images and the build cache, only while Docker is running
#   Other          leftover app updater downloads, the Trash
#
# With -d (deep), it then asks yes or no (default no) before each of these:
#   iPhone backups, one per device; Android system images, one each, noting any an emulator
#   uses; Docker containers, images and build cache not in use (volumes are always kept);
#   the Chrome cache (skipped while Chrome is open); the Codex runtimes the ChatGPT app
#   re-downloads when needed; and pyenv Python versions other than the global one.
#
# Never touched, only listed at the end with their sizes: installed Node versions, test
# browsers (Puppeteer, Cypress), ML models and ~/Downloads.
#
# Usage: cleanup [-n] [-d]
#   -n  dry run: show what each step would clear and its size, without deleting anything
#   -d  deep: also ask about the large items above, one by one

set -uo pipefail

DRY_RUN=0
DEEP=0
for arg in "$@"; do
	case "$arg" in
		-n|--dry-run) DRY_RUN=1 ;;
		-d|--deep) DEEP=1 ;;
		-nd|-dn) DRY_RUN=1; DEEP=1 ;;
		-h|--help) sed -n '3,32p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) echo "cleanup: unknown option $arg (try --help)" >&2; exit 1 ;;
	esac
done
if (( DEEP && ! DRY_RUN )) && [ ! -t 0 ]; then
	echo "cleanup: -d asks questions, so run it in a terminal (or add -n to list what it would ask)" >&2
	exit 1
fi

C="$HOME/Library/Caches"
bold=$'\e[1m'; dim=$'\e[2m'; reset=$'\e[0m'

has() { command -v "$1" > /dev/null 2>&1; }

# Free space on the data volume, in KiB
free_kb() { df -k "$HOME" | awk 'NR == 2 { print $4 }'; }

# Total size of the given paths, in KiB (missing paths count as zero)
size_kb() {
	local p total=0
	for p in "$@"; do
		[ -e "$p" ] && total=$(( total + $(du -sk "$p" 2>/dev/null | awk '{ print $1 }') ))
	done
	echo "$total"
}

human() { awk -v k="$1" 'BEGIN { split("K M G T", u); i = 1; while (k >= 1024 && i < 4) { k /= 1024; i++ } printf (i == 1 ? "%d%s" : "%.1f%s"), k, u[i] }'; }

# step NAME PATH... -- COMMAND...
# Show the size of PATHs, then run COMMAND (or just report the size on a dry run).
step() {
	local name="$1" paths=() kb
	shift
	while [ $# -gt 0 ] && [ "$1" != "--" ]; do paths+=("$1"); shift; done
	shift
	kb=$(size_kb "${paths[@]}")
	[ "$kb" -eq 0 ] && return
	printf '%s%-28s%s %8s' "$bold" "$name" "$reset" "$(human "$kb")"
	if [ "$DRY_RUN" -eq 1 ]; then
		printf '  %swould clear%s\n' "$dim" "$reset"
	elif "$@" > /dev/null 2>&1; then
		printf '  cleared\n'
	else
		printf '  failed (run it by hand: %s)\n' "$*"
	fi
}

# ask QUESTION PATH... -- COMMAND...
# Show the size of PATHs and run COMMAND only after a yes (a dry run only lists the question).
ask() {
	local question="$1" paths=() kb reply
	shift
	while [ $# -gt 0 ] && [ "$1" != "--" ]; do paths+=("$1"); shift; done
	shift
	kb=$(size_kb "${paths[@]}")
	[ "$kb" -eq 0 ] && return
	if [ "$DRY_RUN" -eq 1 ]; then
		printf '  %8s  %s  %swould ask%s\n' "$(human "$kb")" "$question" "$dim" "$reset"
		return
	fi
	read -r -p "$(printf '  %8s  %s? [y/N] ' "$(human "$kb")" "$question")" reply < /dev/tty || reply=""
	[[ "$reply" =~ ^[Yy] ]] || return
	if "$@" > /dev/null 2>&1; then
		printf '            removed\n'
	else
		printf '            failed (run it by hand: %s)\n' "$*"
	fi
}

# rm_paths PATH...: delete paths, for caches whose tool has no clean command
rm_paths() { rm -rf "$@"; }

# rm_image PATH: delete an Android system image and the folders it leaves empty
rm_image() { rm -rf "$1" && rmdir "$(dirname "$1")" "$(dirname "$(dirname "$1")")" 2> /dev/null; true; }

before=$(free_kb)
echo "Free before: $(human "$before")"
echo

# --- Homebrew ---------------------------------------------------------------
has brew && step "Homebrew" "$(brew --cache)" -- brew cleanup --prune=all -s

# --- JavaScript -------------------------------------------------------------
# nvm is a shell function, so ~/.npm and nvm's own cache are cleared directly
has npm && step "npm" "$HOME/.npm/_cacache" -- npm cache clean --force
step "nvm downloads" "$HOME/.nvm/.cache" -- rm_paths "$HOME/.nvm/.cache"
has pnpm && step "pnpm store (unused)" "$(pnpm store path 2>/dev/null)" "$C/pnpm" -- pnpm store prune
# `bun pm cache rm` refuses to run outside a project, so the global cache is removed directly
step "bun" "$HOME/.bun/install/cache" -- rm_paths "$HOME/.bun/install/cache"
has deno && step "deno" "$C/deno" -- deno clean
step "node-gyp headers" "$C/node-gyp" -- rm_paths "$C/node-gyp"
step "TypeScript typings" "$C/typescript" -- rm_paths "$C/typescript"

# --- Python -----------------------------------------------------------------
has uv && step "uv" "$(uv cache dir 2>/dev/null)" -- uv cache clean
has pip3 && step "pip" "$C/pip" -- pip3 cache purge
step "Poetry" "$C/pypoetry/cache" "$C/pypoetry/artifacts" -- rm_paths "$C/pypoetry/cache" "$C/pypoetry/artifacts"
conda="$(brew --prefix 2>/dev/null)/Caskroom/miniforge/base/bin/conda"
[ -x "$conda" ] && step "conda packages" "$(dirname "$(dirname "$conda")")/pkgs" -- "$conda" clean --all --yes
has pre-commit && step "pre-commit (unused)" "$HOME/.cache/pre-commit" -- pre-commit gc

# --- PHP --------------------------------------------------------------------
has composer && step "Composer" "$C/composer" -- composer clear-cache
step "phpactor index" "$HOME/.cache/phpactor" -- rm_paths "$HOME/.cache/phpactor"

# --- JVM and mobile ---------------------------------------------------------
if pgrep -f GradleDaemon > /dev/null; then
	echo "Gradle                       skipped (a Gradle daemon is running; stop it with gradle --stop)"
else
	step "Gradle" "$HOME/.gradle/caches" -- rm_paths "$HOME/.gradle/caches"
fi
has pod && step "CocoaPods" "$C/CocoaPods" -- pod cache clean --all
# Each Android Studio version keeps its own cache folder; only the installed one is in use
studio_info="/Applications/Android Studio.app/Contents/Resources/product-info.json"
if [ -f "$studio_info" ]; then
	current=$(sed -n 's/.*"dataDirectoryName": *"\([^"]*\)".*/\1/p' "$studio_info" | head -1)
	old_studio=()
	for d in "$C"/Google/AndroidStudio*; do
		[ -d "$d" ] && [ -n "$current" ] && [ "$(basename "$d")" != "$current" ] && old_studio+=("$d")
	done
	[ ${#old_studio[@]} -gt 0 ] && step "Old Android Studio caches" "${old_studio[@]}" -- rm_paths "${old_studio[@]}"
fi

# --- Rust and Go ------------------------------------------------------------
# The registry index stays, so cargo works offline for crates it has already resolved
step "cargo downloads" "$HOME/.cargo/registry/cache" "$HOME/.cargo/registry/src" "$HOME/.cargo/git/checkouts" \
	-- rm_paths "$HOME/.cargo/registry/cache" "$HOME/.cargo/registry/src" "$HOME/.cargo/git/checkouts"
has go && step "Go build cache" "$(go env GOCACHE 2>/dev/null)" -- go clean -cache

# --- Xcode ------------------------------------------------------------------
dev="$HOME/Library/Developer"
step "Xcode DerivedData" "$dev/Xcode/DerivedData" -- rm_paths "$dev/Xcode/DerivedData"
step "Simulator caches" "$dev/CoreSimulator/Caches" -- rm_paths "$dev/CoreSimulator/Caches"
has xcrun && [ "$DRY_RUN" -eq 0 ] && xcrun simctl delete unavailable > /dev/null 2>&1

# --- Docker -----------------------------------------------------------------
docker_up=0
has docker && docker info > /dev/null 2>&1 && docker_up=1
if (( docker_up )); then
	if [ "$DRY_RUN" -eq 1 ]; then
		echo "Docker                       would remove dangling images and the build cache"
	else
		docker image prune --force > /dev/null 2>&1
		docker builder prune --force > /dev/null 2>&1
		echo "Docker                       removed dangling images and the build cache"
	fi
fi

# --- Other ------------------------------------------------------------------
shopt -s nullglob
updaters=("$C"/*.ShipIt "$C"/*-updater "$C"/fanal)
shopt -u nullglob
[ ${#updaters[@]} -gt 0 ] && step "App updater leftovers" "${updaters[@]}" -- rm_paths "${updaters[@]}"
shopt -s nullglob dotglob
trash=("$HOME/.Trash"/*)
shopt -u nullglob dotglob
[ ${#trash[@]} -gt 0 ] && step "Trash" "${trash[@]}" -- rm_paths "${trash[@]}"

# --- Deep: ask before each large item -----------------------------------------
if (( DEEP )); then
	echo
	echo "${bold}Deep clean${reset} ${dim}(Enter keeps it; y removes it)${reset}"

	# iPhone backups, one per device, named as Finder shows them
	backups="$HOME/Library/Application Support/MobileSync/Backup"
	for d in "$backups"/*/; do
		d="${d%/}"
		[ -f "$d/Info.plist" ] || continue
		name=$(plutil -extract "Device Name" raw "$d/Info.plist" 2> /dev/null || echo "unknown device")
		date=$(plutil -extract "Last Backup Date" raw "$d/Info.plist" 2> /dev/null | cut -c1-10)
		ask "iPhone backup of “${name}” from ${date:-an unknown date}" "$d" -- rm_paths "$d"
	done

	# Android system images, noting any that an emulator uses or that cannot run on this Mac
	images="$HOME/Library/Android/sdk/system-images"
	for img in "$images"/*/*/*/; do
		img="${img%/}"
		[ -d "$img" ] || continue
		rel="${img#"$HOME/Library/Android/sdk/"}"
		note=""
		users=$(grep -l "^image.sysdir.1 *= *$rel/" "$HOME"/.android/avd/*.avd/config.ini 2> /dev/null \
			| xargs -n1 dirname 2> /dev/null | xargs -n1 basename 2> /dev/null | sed 's/\.avd$//' | paste -sd, -)
		[ -n "$users" ] && note=" (used by the $users emulator)"
		[ "$(uname -m)" = arm64 ] && [[ "$img" == */x86 || "$img" == */x86_64 ]] && note=" (x86, cannot run on this Mac)"
		ask "Android image ${rel#system-images/}$note" "$img" -- rm_image "$img"
	done

	# Docker: everything not in use by a container, but never volumes, which hold data
	if (( docker_up )); then
		ask "Docker containers, images and build cache not in use (volumes kept)" \
			"$HOME/Library/Containers/com.docker.docker" -- docker system prune --all --force
	elif [ -d "$HOME/Library/Containers/com.docker.docker" ]; then
		echo "  Docker is not running; start Docker Desktop and run cleanup -d again to clean it"
	fi

	# Chrome cache; deleting it under a running Chrome only gets it rewritten
	if pgrep -xq "Google Chrome"; then
		echo "  Chrome cache skipped while Chrome is open; quit it and run cleanup -d again"
	else
		ask "Chrome cache" "$C/Google/Chrome" -- rm_paths "$C/Google/Chrome"
	fi

	# Codex runtimes: the Node, Python and LibreOffice bundle the ChatGPT app's Codex agent
	# uses for documents, plus leftover install folders; it is downloaded again when needed
	ask "Codex runtimes (ChatGPT downloads them again when needed)" \
		"$HOME/.cache/codex-runtimes" -- rm_paths "$HOME/.cache/codex-runtimes"

	# pyenv Python versions, except the global one
	if has pyenv; then
		global=$(pyenv global 2> /dev/null | head -1)
		for v in $(pyenv versions --bare --skip-aliases 2> /dev/null); do
			[ "$v" = "$global" ] && continue
			ask "Python $v (pyenv)" "$(pyenv root)/versions/$v" -- pyenv uninstall --force "$v"
		done
	fi
fi

after=$(free_kb)
echo
if [ "$DRY_RUN" -eq 0 ]; then
	echo "Free after:  $(human "$after") (${bold}$(human $(( after > before ? after - before : 0 )))${reset} freed)"
	echo
fi

# --- Left for a decision by hand --------------------------------------------
review() {
	local kb
	kb=$(size_kb "$2")
	[ "$kb" -gt 102400 ] || return 0
	if [ -n "$3" ]; then
		printf '  %8s  %-42s %s%s%s\n' "$(human "$kb")" "$1" "$dim" "$3" "$reset"
	else
		printf '  %8s  %s\n' "$(human "$kb")" "$1"
	fi
}
echo "Not touched; review these by hand if you need more room:"
if (( ! DEEP )); then
	review "iPhone backups" "$HOME/Library/Application Support/MobileSync/Backup" "cleanup -d"
	review "Android system images" "$HOME/Library/Android/sdk/system-images" "cleanup -d"
	review "Docker disk image" "$HOME/Library/Containers/com.docker.docker" "cleanup -d"
	review "Python versions" "$HOME/.pyenv/versions" "cleanup -d"
	review "Codex runtimes" "$HOME/.cache/codex-runtimes" "cleanup -d"
	review "Chrome cache" "$C/Google/Chrome" "cleanup -d"
fi
review "Downloads" "$HOME/Downloads" ""
review "Node versions" "$HOME/.nvm/versions/node" "nvm ls, then nvm uninstall VERSION"
review "Puppeteer browsers" "$HOME/.cache/puppeteer" "reinstalled by npm install in projects using it"
review "Cypress binaries" "$C/Cypress" "npx cypress cache prune"
review "Hugging Face models" "$HOME/.cache/huggingface" ""
